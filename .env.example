# Set to the site's real HTTPS origin in production for absolute job share-card URLs.
# Example shape: https://jobs.example.tz
# Leave blank in Preview; the app uses the explicitly configured project Preview origin.
PUBLIC_SITE_ORIGIN=

# Required for job-ad PDF/image structuring through the Manus API.
MANUS_API_KEY=

# Required to read/write existing Manus-managed media from a non-Manus host
# such as Railway. Copy both values from the original Manus project settings.
MANUS_API_URL=

# Optional on Railway when using local fallback storage; mount a persistent
# Volume and set UPLOAD_DIR to a directory on that Volume (e.g. /data/uploads).
UPLOAD_DIR=
