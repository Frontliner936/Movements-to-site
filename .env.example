# Existing MySQL database connection (preserve the current database and records).
DATABASE_URL=

# Set a strong private admin password in Railway. Admin email is configured in server/getmchongo/auth.ts.
ADMIN_PASSWORD=

# AI job-ad extraction, photo reading, and translation.
# Create an API key with your AI provider; the default endpoint/model are OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint override; leave blank for https://api.openai.com/v1.
OPENAI_API_BASE=

# Optional public origin used for job share-card metadata.
PUBLIC_SITE_ORIGIN=

# Railway: create and mount a persistent Volume at /data.
# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically; the app stores files in <mount>/uploads.
# Set this only if you want to override that automatic directory.
UPLOAD_DIR=
