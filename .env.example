# Existing MySQL database connection (preserve the current database and records).
DATABASE_URL=

# Set a strong private admin password in Railway. Admin email is configured in server/getmchongo/auth.ts.
ADMIN_PASSWORD=

# No AI provider/API key is required for importing job ads.
# The Docker image includes local Tesseract OCR, PDF rendering tools, and offline English↔Kiswahili models.

# Public HTTPS origin for stable job links in share cards and email alerts.
# Share cards can fall back to forwarded request headers; email alerts require this or RAILWAY_PUBLIC_DOMAIN.
PUBLIC_SITE_ORIGIN=

# Optional transactional SMTP for members who separately opt in to matching-job emails.
# Use the sender address verified by your provider; configure values privately in Railway.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Get Mchongo

# Railway: create and mount a persistent Volume at /data.
# Railway sets RAILWAY_VOLUME_MOUNT_PATH automatically; the app stores files in <mount>/uploads.
# Set this only if you want to override that automatic directory.
UPLOAD_DIR=

# Optional visitor accounts: set a unique random value of at least 32 characters in Railway.
MEMBER_SESSION_SECRET=

# Separate recruiter login/session signing key; set a unique random value of at least 32 characters.
RECRUITER_SESSION_SECRET=
